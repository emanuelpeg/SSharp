<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SSharp.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.67.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.5.5" />
    <!-- Pin to patched version to resolve NU1903 vulnerability in Microsoft.OpenApi 2.0.0 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\eval.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SSharp.Compiler\SSharp.Compiler.csproj" />
    <ProjectReference Include="..\SSharp.Backend\SSharp.Backend.csproj" />
  </ItemGroup>

</Project>
